{
    "name": "vatger/website",
    "type": "project",
    "description": "The vACC Germany Website.",
    "keywords": [
        "vatger",
        "vatsim"
    ],
    "license": "none",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/paulhollmann/vatsim-stand-status.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-simplexml": "*",
        "doctrine/dbal": "^3.3",
        "firebase/php-jwt": "^6.10",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^3.6",
        "jeremy379/laravel-openid-connect": "^2.3",
        "laravel/framework": "^11.7",
        "laravel/passport": "^12.2",
        "laravel/ui": "^4.2",
        "league/commonmark": "^2.3",
        "league/oauth2-client": "^2.6",
        "livewire/livewire": "^v3.2",
        "paragonie/paseto": "^1.1",
        "paulhollmann/vatsim-data": "dev-master",
        "paulhollmann/vatsim-stand-status": "dev-master",
        "spatie/icalendar-generator": "^2.8",
        "spatie/laravel-collection-macros": "^7.14",
        "spatie/laravel-permission": "^6.9",
        "statikbe/laravel-cookie-consent": "^1.8",
        "stevebauman/purify": "^6.0",
        "tartanlegrand/laravel-openapi": "^2.0",
        "tightenco/ziggy": "^1.6",
        "weberhofer/jsonrpcphp": "^2.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^v3.13.5",
        "barryvdh/laravel-ide-helper": "^v3.1.0",
        "fakerphp/faker": "^1.20.0",
        "laravel/pint": "^1.19",
        "laravel/sail": "^1.16",
        "laravel/tinker": "^2.7",
        "mockery/mockery": "^1.5.0",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.8"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": [
                "app/"
            ],
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
            "@php artisan ziggy:generate"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
