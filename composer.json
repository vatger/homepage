{
  "name": "vatger/website",
  "type": "project",
  "description": "The vACC Germany Website.",
  "keywords": [
    "vatger",
    "vatsim"
  ],
  "license": "none",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/paulhollmann/vatsim-stand-status.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/laravel-shift/laravel-openid-connect.git"
    }
  ],
  "require": {
    "php": "8.4.*",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-pdo": "*",
    "ext-simplexml": "*",
    "dedoc/scramble": "^0.13.8",
    "doctrine/dbal": "^3.9",
    "firebase/php-jwt": "^6.10",
    "guzzlehttp/guzzle": "^7.8",
    "intervention/image": "^3.6",
    "jeremy379/laravel-openid-connect": "dev-l12-compatibility",
    "laravel/framework": "^12.28",
    "laravel/passport": "^12.4",
    "laravel/ui": "^4.6",
    "league/commonmark": "^2.6",
    "league/oauth2-client": "^2.8",
    "livewire/livewire": "^v3.6",
    "paulhollmann/vatsim-data": "^v1.0.1",
    "paulhollmann/vatsim-stand-status": "dev-master",
    "spatie/icalendar-generator": "^3.2",
    "spatie/laravel-collection-macros": "^8.0",
    "spatie/laravel-permission": "^6.21",
    "statikbe/laravel-cookie-consent": "^1.10",
    "stevebauman/purify": "^6.3",
    "tightenco/ziggy": "^2.5",
    "weberhofer/jsonrpcphp": "^2.2"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^v4.1",
    "barryvdh/laravel-ide-helper": "^v3.6",
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "laravel/sail": "^1.45",
    "laravel/tinker": "^2.10",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.8",
    "phpunit/phpunit": "^12.5",
    "spatie/laravel-ignition": "^2.9"
  },
  "autoload": {
    "files": [
      "app/helpers.php"
    ],
    "psr-4": {
      "App\\": [
        "app/"
      ],
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
      "@php artisan ziggy:generate --types"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
