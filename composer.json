{
  "name": "vatger/website",
  "type": "project",
  "description": "The vACC Germany Website.",
  "keywords": [
    "vatger",
    "vatsim"
  ],
  "license": "none",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/paulhollmann/vatsim-stand-status.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/paulhollmann/vatsim-datafeed.git"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-curl": "*",
    "ext-simplexml": "*",
    "doctrine/dbal": "^3.3",
    "guzzlehttp/guzzle": "^7.8",
    "intervention/image": "^3.1",
    "laravel/framework": "^10.35",
    "laravel/ui": "^4.2",
    "league/commonmark": "^2.3",
    "league/oauth2-client": "^2.6",
    "livewire/livewire": "^v3.2",
    "paragonie/paseto": "^1.1",
    "paulhollmann/vatsim-stand-status": "dev-master",
    "spatie/laravel-cookie-consent": "^3.2",
    "spatie/laravel-permission": "^5.7",
    "spatie/laravel-webhook-client": "^3.1",
    "stevebauman/purify": "^6.0",
    "tightenco/ziggy": "^1.6",
    "vyuldashev/laravel-openapi": "^1.11",
    "weberhofer/jsonrpcphp": "^2.2"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.7",
    "barryvdh/laravel-ide-helper": "^2.12",
    "fakerphp/faker": "^1.20.0",
    "kitloong/laravel-migrations-generator": "^6.6",
    "laravel/sail": "^1.16",
    "laravel/tinker": "^2.7",
    "mockery/mockery": "^1.5.0",
    "nunomaduro/collision": "^6.3",
    "phpunit/phpunit": "^10.0",
    "spatie/laravel-ignition": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": [
        "app/"
      ],
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan vendor:publish --force --tag=livewire:assets --ansi",
      "@php artisan ziggy:generate"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
