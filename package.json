{
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "laravel:check": "php ./vendor/bin/pint --test",
    "laravel:write": "php ./vendor/bin/pint -v",
    "prettier:check:js": "npx prettier --check {**/*,*}.{js,ts,jsx,tsx}",
    "prettier:check:html": "npx prettier --check {**/*,*}.{html,htm,css,sass}",
    "prettier:check:other": "npx prettier --check {**/*,*}.{json,yml,csv,md}",
    "prettier:write:js": "npx prettier --write {**/*,*}.{js,ts,jsx,tsx}",
    "prettier:write:html": "npx prettier --write {**/*,*}.{html,htm,css,sass}",
    "prettier:write:other": "npx prettier --write {**/*,*}.{json,yml,csv,md}",
    "prettier:check:all": "npm run laravel:check && npx prettier --check {**/*,*}.{js,ts,jsx,tsx,html,htm,css,sass,json,yml,csv,md}",
    "prettier:write:all": "npm run laravel:write && npx prettier --write {**/*,*}.{js,ts,jsx,tsx,html,htm,css,sass,json,yml,csv,md}",
    "format:check": "npm run prettier:check:all",
    "format:write": "npm run prettier:write:all"
  },
  "devDependencies": {
    "@shufo/prettier-plugin-blade": "^1.15.1",
