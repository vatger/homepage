{
    "private": true,
    "scripts": {
        "dev": "npm run development",
        "development": "mix",
        "watch": "mix watch",
        "watch-poll": "mix watch -- --watch-options-poll=1000",
        "hot": "mix watch --hot",
        "prod": "npm run production",
        "production": "mix --production",
        "prettier:check:php": "npx prettier --check {**/*,*}.php",
        "prettier:check:js": "npx prettier --check {**/*,*}.{js,ts,jsx,tsx}",
        "prettier:check:html": "npx prettier --check {**/*,*}.{html,htm,css,sass}",
        "prettier:check:other": "npx prettier --check {**/*,*}.{json,yml,csv,md}",
        "prettier:write:php": "npx prettier --write {**/*,*}.php",
        "prettier:write:js": "npx prettier --write {**/*,*}.{js,ts,jsx,tsx}",
        "prettier:write:html": "npx prettier --check {**/*,*}.{html,htm,css,sass}",
        "prettier:write:other": "npx prettier --write {**/*,*}.{json,yml,csv,md}",
        "prettier:check:all": "npm run prettier:check:php && npm run prettier:check:js && npm run prettier:check:html && npm run prettier:check:other",
        "prettier:write:all": "npm run prettier:write:php && npm run prettier:write:js && npm run prettier:write:html && npm run prettier:write:other",
        "prettier:check": "npm run prettier:check:all",
        "prettier:write": "npm run prettier:write:all",
        "prepare": "husky install"
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.6.3",
        "axios": "^0.21",
        "laravel-mix": "^6.0.6",
        "lodash": "^4.17.19",
        "postcss": "^8.1.14",
        "prettier": "^2.7.1",
        "pretty-quick": "^3.1.3",
        "resolve-url-loader": "^5.0.0",
        "sass": "^1.49.0",
        "sass-loader": "^12.4.0"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "5.11.2",
        "@popperjs/core": "^2.6.0",
        "apexcharts": "^3.35.0",
        "bootstrap": "^5.0.1",
        "jquery": "^3.6.0",
        "luxon": "^2.3.2",
        "noty": "^3",
        "tinymce": "^5.10.4"
    },
    "name": "vacc-germany-website",
    "description": "vACC Germany Website",
    "version": "3.0.0",
    "main": "webpack.mix.js",
    "directories": {
        "test": "tests"
    },
    "author": "Sebastian Kramer, Paul Hollmann, Nikolas Görlitz",
    "license": "ISC"
}
