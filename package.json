    "postcss": "^8.1.14",
    "prettier": "^2.7.1",
    "pretty-quick": "^3.1.3",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.49.0",
    "sass-loader": "^12.4.0",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "@popperjs/core": "^2.6.0",
    "@ryangjchandler/alpine-clipboard": "^2.2.0",
    "@types/toastify-js": "^1.12.0",
    "@types/ziggy-js": "^1.3.2",
    "apexcharts": "^3.35.0",
    "bootstrap": "^5.0.1",
    "dayjs": "^1.11.9",
    "feather-icons": "^4.29.0",
    "gumshoejs": "^5.1.2",
